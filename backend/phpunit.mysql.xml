<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap-mysql.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- MySQL 版。sqlite との差異 (一意制約・日時・文字コードなど) を確認したいとき用。
                 docker compose exec backend php artisan test -c phpunit.mysql.xml
             接続先は開発用 (ebooks_local) とは別の ebooks_test。RefreshDatabase が
             毎回テーブルを落とすため、開発用 DB を向けてはいけない。
             上書きの仕組みは phpunit.xml と同じで、$_SERVER ごと差し替える。
             ebooks_test が無ければ bootstrap (tests/bootstrap-mysql.php) が root で作る -->
        <server name="DB_ROOT_USERNAME" value="root" force="true"/>
        <server name="DB_ROOT_PASSWORD" value="root" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="DB_CONNECTION" value="mysql" force="true"/>
        <server name="DB_HOST" value="db" force="true"/>
        <server name="DB_PORT" value="3306" force="true"/>
        <server name="DB_DATABASE" value="ebooks_test" force="true"/>
        <server name="DB_USERNAME" value="ebooks" force="true"/>
        <server name="DB_PASSWORD" value="password" force="true"/>
    </php>
</phpunit>
