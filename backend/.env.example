APP_NAME=Laravel
APP_ENV=local
# 開発では docker-entrypoint.sh が空なら artisan key:generate で作る。
# 本番では生成しない。起動のたびに鍵が変わると、暗号化済みのデータ
# (セッションなど) が読めなくなるため、必ず外から環境変数で渡す。
# Cloud Run なら Secret Manager 経由が望ましい:
#   gcloud run deploy ... --set-secrets=APP_KEY=app-key:latest
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
# 絶対URLの基点。Web リクエスト中は「リクエストのホスト」が使われるため
# ここは効かず、効くのは artisan やキュー・メールのようにリクエストが無い文脈。
# 本番は Cloud Run のサービスごとに値が違う (同じイメージを2サービスで使うため)。
#   ebook-api   -> APP_URL=https://api.ebook.furusawa.work
#   ebook-admin -> APP_URL=https://admin.ebook.furusawa.work
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Cloud Run から Cloud SQL に繋ぐときは、ここにソケットのパスを入れる。
#   DB_SOCKET=/cloudsql/<PROJECT>:<REGION>:<INSTANCE>
# 空でなければ Laravel は DB_HOST / DB_PORT を見ずにソケットで接続するので、
# DB_HOST を消す必要はない (MySqlConnector::getDsn が socket を優先する)。
# DB_SOCKET=
DB_TIMEZONE=+09:00

# Cloud Run はインスタンスが使い捨てで同時に複数立つため、file だと
# ログインしたインスタンスと次のリクエストを受けるインスタンスが違うたびに
# ログイン画面へ戻される。sessions テーブルは Laravel 同梱のマイグレーションで
# 作られるので追加のコードは要らない (step07 の 13)。
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Cookie を送る先のホスト。null = そのホストだけに送る (ホスト限定 Cookie)。
#
# step07 の 15 は admin.ebook.furusawa.work を入れる想定だが、実測したところ
# 指定すると Set-Cookie に domain= が付き、そのホストとその配下のサブドメインに
# 送られるようになる。null のままの方がホスト限定で厳しいので、こちらを既定にする。
# 「Cookie を admin. に閉じる」という意図はどちらでも満たせる。
SESSION_DOMAIN=null

# HTTPS のときだけ Cookie を送る。APP_ENV=production なら未設定でも true。
# ローカルで本番イメージを http で動かすときだけ false を渡す。
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# API を fetch してよいオリジン (カンマ区切り)。
# サブドメインで分けているため www. から api. への fetch はクロスオリジンになる。
# 本番: CORS_ALLOWED_ORIGINS=https://www.ebook.furusawa.work,https://ebook.furusawa.work
CORS_ALLOWED_ORIGINS=http://localhost:8080

# 画像の配り元。ブラウザから見えるホスト名を入れる。
# 本番 (Cloud Run) では必ず渡す。未設定だと画像URLが localhost になる。
#   CDN_BASE_URL=https://cdn.ebook.furusawa.work
CDN_BASE_URL=http://localhost:8082
CDN_ROOT=/var/www/cdn

# 画像の保存先。既定 (未設定) はローカルディスクで、開発では上の CDN_ROOT に書く。
# Cloud Run にはローカルディスクが無い (書けてもインスタンスが消えれば失われる) ので
# 本番は gcs に切り替える。差し替わるのは config/filesystems.php の cdn ディスクだけで、
# Storage::disk('cdn') を呼ぶコントローラ側は変更不要 (step07 の 14)。
#   CDN_DISK=gcs
#   CDN_BUCKET=<バケット名>
#   GOOGLE_CLOUD_PROJECT=<プロジェクトID>
# 認証は Cloud Run のサービスアカウントが ADC として拾われるので鍵ファイルは不要。
#
# CDN_GCS_ENDPOINT は開発で GCS エミュレータ (fake-gcs-server) に向けるとき用。
# 設定すると認証を無効化するので、本番では必ず空にしておくこと。
#   CDN_GCS_ENDPOINT=http://fakegcs:4443
